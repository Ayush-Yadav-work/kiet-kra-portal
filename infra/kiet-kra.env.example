# Example environment for the web service and the artifact worker (copy to /etc/kiet-kra/kiet-kra.env, mode 0640).
# Values here are placeholders; never commit real secrets.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgresql://kiet_kra:change-me@127.0.0.1:5432/kiet_kra
DJANGO_ALLOWED_HOSTS=kra.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://kra.example.edu
# Shared private storage: the web service and the worker must point at the same directory.
PRIVATE_STORAGE_ROOT=/srv/kiet-kra/private
# Internal-only renderer (bind to 127.0.0.1 or a private network).
RENDERER_URL=http://127.0.0.1:8790
RENDERER_TIMEOUT_SECONDS=45
# Approved-PDF worker (defaults shown).
ARTIFACT_POLL_SECONDS=2
ARTIFACT_MAX_ATTEMPTS=5
ARTIFACT_BACKOFF_SECONDS=30
ARTIFACT_HEARTBEAT_STALE_SECONDS=60
ARTIFACT_BACKLOG_WARN=200
# Bulk approval (defaults shown; the batch size cannot exceed 50).
BULK_MANIFEST_CAP=5000
BULK_BATCH_SIZE=50
