      "id": "audit", "title": "1. Gender audit",
      "intro": "Project-created format awaiting institutional review. One section per gender audit. An audit done in an earlier period can be reported again to record follow-up progress — no new audit is needed each period. Record aggregate observations only: no individual complaints or case details.",
      "fields": [
        {"id": "audit_title", "label": "Audit title", "type": "text", "required": true, "max_length": 250},
        {"id": "reporting_basis", "label": "Reported in this period as", "type": "select", "required": true,
         "options": ["Audit conducted in this period", "Follow-up of an earlier audit"]},
        {"id": "audit_date", "label": "Date of audit (or report date)", "type": "date", "required": true},
        {"id": "audit_scope", "label": "Scope of the audit", "type": "longtext", "required": true, "max_length": 2000},
        {"id": "audit_team", "label": "Audit team / committee (names, roles)", "type": "longtext", "required": true, "max_length": 1500},
        {"id": "audit_reference", "label": "Audit report reference (optional)", "type": "text", "required": false, "max_length": 150}
      ]
    },
