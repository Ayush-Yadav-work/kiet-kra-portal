{
  "key": "kra15",
  "version": 1,
  "title": "No of Entrepreneur (Faculty/Alumni/Student)",
  "sheet_title": "Entrepreneurs (Faculty / Alumni / Student)",
  "renderer": "reports/records_sheet_v1.html",
  "source": "reference/templates/KRA 15 Entrepreneur (Faculty_Alumni_ Student).xlsx - Entrepreneur.pdf",
  "source_checksum": "5b291840e63d65b474e1dc309d044a528d569f0d59fecd335ea6f405f3b62fc5",
  "page": {"format": "A4", "landscape": true, "style": "sheet"},
  "activity": {"label": "Report", "min": 1, "max": 1},
  "sections": [
    {
      "id": "records", "title": "Entrepreneurs",
      "intro": "One record per entrepreneur (faculty member, student or alumnus) and enterprise. Academic Year is filled from this report. For faculty, enter the Employee ID; Programme and Batch/Passing Year apply only to students and alumni. The source's sample years are examples only.",
      "fields": [
        {"id": "records", "label": "Entrepreneur records", "type": "table", "required": true, "min_rows": 1, "max_rows": 100, "editor": "cards",
         "columns": [
           {"id": "academic_year", "label": "Academic Year", "type": "auto", "source": "year", "width": "5%"},
           {"id": "name", "label": "Name of Entrepreneur", "type": "text", "required": true, "max_length": 150, "width": "8.5%"},
           {"id": "category", "label": "Category", "type": "select", "required": true, "options": ["Student", "Alumni", "Faculty"], "width": "5.5%"},
           {"id": "member_id", "label": "Student/Alumni ID (Employee ID for Faculty)", "type": "text", "required": true, "max_length": 40, "width": "7%"},
           {"id": "programme", "label": "Programme", "type": "text", "required": true, "max_length": 100, "width": "6.5%", "placeholder": "e.g. B.Tech ECE",
            "when": {"field": "category", "in": ["Student", "Alumni"]}},
           {"id": "batch", "label": "Batch/ Passing Year", "type": "text", "required": true, "max_length": 20, "width": "5.5%", "placeholder": "e.g. 2022–2026",
            "when": {"field": "category", "in": ["Student", "Alumni"]}},
           {"id": "gender", "label": "Gender", "type": "select", "required": true, "options": ["Female", "Male", "Other"], "width": "5%"},
           {"id": "enterprise", "label": "Startup/ Enterprise Name", "type": "text", "required": true, "max_length": 200, "width": "9%"},
           {"id": "sector", "label": "Sector/ Domain", "type": "text", "required": true, "max_length": 120, "width": "7.5%"},
           {"id": "founder_role", "label": "Founder/ Co-Founder", "type": "select", "required": true, "options": ["Founder", "Co-Founder"], "width": "6%"},
           {"id": "year_established", "label": "Year of Establishment", "type": "integer", "required": true, "min": 1900, "max": 2100, "width": "7%"},
           {"id": "registration_no", "label": "Registration No. /DPIIT No.", "type": "text", "required": false, "max_length": 80, "width": "8%",
            "help": "Leave blank if the enterprise is not registered or has no DPIIT recognition (registration is not required by the source)."},
           {"id": "status", "label": "Current Status", "type": "select", "required": true, "options": ["Active", "Closed"], "width": "5.5%"},
           {"id": "evidence_available", "label": "Evidence Available", "type": "select", "required": true, "options": ["Yes", "No"], "width": "5.5%",
            "help": "Whether supporting documents exist; upload them in the Evidence tab."}
         ]}
      ]
    }
  ],
  "evidence": {
    "categories": ["Registration/Incorporation Certificate", "DPIIT Recognition", "Proof of Founder/Co-Founder Role", "Other"],
    "required": [],
    "note": "The source has only an 'Evidence Available' column; no minimum set has been agreed (docs/decisions.md D-044)."
  }
}
